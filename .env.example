REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql://app:app@postgres:5432/chat

# Логи: читаемый однострочный текст в stdout (`docker compose logs -f`). Уровень:
# DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL=INFO
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Авторизация. Для веб-входа (email+пароль -> JWT) держите DEV_MODE=false (дефолт).
# DEV_MODE=true ОТКЛЮЧАЕТ auth (любой токен = личность) — только для ручных ws-тестов.
AUTH_DEV_MODE=false
# СЕКРЕТ подписи JWT — ОБЯЗАТЕЛЬНО задайте своё длинное случайное значение!
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-to-a-long-random-secret
# Срок жизни токена (сек), по умолчанию 7 дней.
AUTH_TOKEN_TTL_SECONDS=604800
# CORS: страница и API на одном origin, поэтому для теста достаточно "*".
# Для прода сузьте до вашего домена, напр. https://chat.example.com
CORS_ALLOW_ORIGINS=*
# Максимальная длина одного входящего сообщения (символов).
MAX_MESSAGE_CHARS=8000
# Рейтлимит входящих ws-сообщений на пользователя (H2): не больше N за окно (сек).
# Защищает общий inbound-стрим от флуда одним клиентом (вытеснение чужих сообщений).
WS_RATE_MAX_MESSAGES=30
WS_RATE_WINDOW_SECONDS=10

# TTL ленты токенов ВО ВРЕМЯ генерации (H1): брошенная при жёстком падении воркера
# лента протухнет через столько секунд после последнего токена. Держите > паузы
# между токенами (иначе живой медленный стрим протухнет на лету).
GEN_ACTIVE_TTL_SECONDS=900

# FIFO-гейт: сколько ждать «дырявого» предшественника перед пропуском разрыва (H3).
# Держите БОЛЬШЕ худшей задержки «отправка -> вычитка воркером» под нагрузкой, иначе
# под backlog гейт может отбросить реальные (лишь опоздавшие) сообщения. Каждый
# пропуск логируется как [order][LOSS] — заведите на него алерт.
ORDER_GAP_TIMEOUT_MS=120000

# TTL счётчиков порядка диалога seq/applied/since_sum (M1): без него растут вечно.
# Держите заметно больше времени обработки/бэклога и ORDER_GAP_TIMEOUT_MS.
CONV_COUNTER_TTL_SECONDS=86400

# Тайминги замка/реклейма (M2). Валидатор требует:
#   LOCK_HEARTBEAT_SECONDS < CONV_LOCK_TTL_SECONDS  и
#   RECLAIM_MIN_IDLE_MS >= CONV_LOCK_TTL_SECONDS*1000.
# Оба TTL держите БОЛЬШЕ максимального времени ответа модели.
CONV_LOCK_TTL_SECONDS=300
LOCK_HEARTBEAT_SECONDS=30
RECLAIM_MIN_IDLE_MS=300000

# Таймауты запросов Postgres (M3): без них зависший запрос держит соединение из пула.
PG_COMMAND_TIMEOUT=30
PG_STATEMENT_TIMEOUT_MS=30000

# TTL замка суммаризации (R4): продлевается heartbeat'ом во время долгой свёртки.
# Валидатор требует LOCK_HEARTBEAT_SECONDS < этого значения.
SUMMARIZE_LOCK_TTL_SECONDS=300

# Dead-letter (R5): после скольких доставок «отравленная» задача уходит в <stream>:dead.
# Разбирать: `XRANGE chat:inbound:dead - +`.
MAX_DELIVERIES=5
DEAD_LETTER_MAXLEN=10000

# --- Контекст модели / бюджет токенов ---
# Полное контекстное окно ВАШЕЙ модели. Это реальный потолок: приложение гарантирует
# промпт + ответ + запас <= этого значения.
CONTEXT_WINDOW_TOKENS=256000
# Резерв под ответ (max_tokens запроса).
MAX_RESPONSE_TOKENS=4096
# Потолок промпта. 0 = АВТО (занять окно по максимуму за вычетом ответа и запаса).
# Можно задать явное число, если хотите ограничить стоимость/латентность.
PROMPT_TOKEN_BUDGET=0
# Запас на неточность подсчёта токенов для не-OpenAI моделей (доля окна).
TOKEN_SAFETY_RATIO=0.05

# tiktoken в закрытом контуре: чтобы не ходил в сеть за BPE-рангами, положите кэш
# в образ и укажите путь (иначе включится грубая эвристика подсчёта токенов).
# TIKTOKEN_CACHE_DIR=/opt/tiktoken_cache
