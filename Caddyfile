# Единая точка входа + TLS-терминация (H3).
# SITE_ADDRESS из окружения (docker-compose):
#   :80                     -> HTTP «из коробки» (localhost/по IP), без сертификата;
#   chat.example.com        -> Caddy сам получит и продлит TLS-сертификат (Let's Encrypt),
#                              а http автоматически редиректит на https.
# reverse_proxy прозрачно проксирует и обычные запросы, и WebSocket (Upgrade),
# и проставляет X-Forwarded-Proto/For, которым доверяет uvicorn (--forwarded-allow-ips).
{$SITE_ADDRESS} {
	# Заголовки безопасности (L5-review). Namely: HSTS (браузер ходит только по https —
	# действует, когда SITE_ADDRESS=домен с TLS; по http :80 браузер его игнорирует, вреда
	# нет), запрет MIME-sniffing и встраивания в чужой iframe (кликджекинг), скромный
	# referrer. CSP НЕ ставим намеренно: страницы используют inline-скрипты, строгий
	# script-src их сломал бы — при желании добавьте отдельно с nonce/хешами.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	# X-Forwarded-For ПЕРЕЗАПИСЫВАЕМ реальным адресом TCP-пира ({remote_host}), а НЕ
	# добавляем к присланному клиентом (H3). Caddy здесь — интернет-край, поэтому
	# {remote_host} = настоящий клиент. Без этого клиент мог прислать свой X-Forwarded-For,
	# Caddy дописал бы к нему реальный IP, а uvicorn (доверяющий заголовку от caddy) взял бы
	# КЛИЕНТОМ управляемый элемент списка — и per-IP рейтлимит register/login (#3) обходился бы
	# сменой заголовка (брутфорс пароля + CPU-DoS через bcrypt). Перезапись закрывает это
	# независимо от того, какой конец X-Forwarded-For выбирает конкретная версия uvicorn.
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}
